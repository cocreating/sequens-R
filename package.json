{
  "name": "sequens-r",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:bundle && npm run test:e2e"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "svelte-dnd-action": "^0.9.79"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
